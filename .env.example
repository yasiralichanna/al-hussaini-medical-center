# Standard Next.js Node deployment (supports local MongoDB, no replica set needed).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=al_hussaini
SITE_URL=http://localhost:3000
# Optional one-time browser setup. Generate 32 random bytes. Remove after first admin.
ADMIN_SETUP_SECRET=
# admin:create reads password from stdin; these are not public client values.
ADMIN_EMAIL=
ADMIN_NAME=
# Optional authorized email/SMS provider webhook. Must support Idempotency-Key.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
# Explicit development seed gates; never use on production.
ALLOW_DEV_SEED=no

# none shares one public limit; enable only behind an overwriting trusted proxy.
# Values: none, cloudflare, reverse-proxy
TRUST_PROXY_IP=none
